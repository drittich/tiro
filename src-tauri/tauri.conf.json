{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tiro",
  "mainBinaryName": "tiro",
  "identifier": "app.tiro",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Tiro", "width": 960, "height": 720, "minWidth": 480, "minHeight": 400, "visible": false }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' screenshot: http://screenshot.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": ["rpm"],
    "shortDescription": "Records, transcribes and summarizes online meetings",
    "linux": {
      "rpm": {
        "depends": ["opus", "pipewire", "pipewire-libs", "pipewire-utils", "pulseaudio-utils"],
        "obsoletes": ["moneypenny"],
        "desktopTemplate": "tiro.desktop"
      }
    },
    "icon": ["icons/32x32.png", "icons/64x64.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
